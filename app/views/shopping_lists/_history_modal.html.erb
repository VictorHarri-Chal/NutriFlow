<%# locals: (archived_lists:, pagy:) %>
<%= render Ui::ModalComponent.new(title: t("views.shopping_lists.history_heading"), max_width: :md, max_height: :sm) do |m| %>
  <% m.with_body do %>
    <% if archived_lists.any? %>
      <div class="space-y-3">
        <% archived_lists.each do |list| %>
          <%= render "shopping_lists/archived_list_card", list: list %>
        <% end %>
      </div>

      <% if pagy&.pages&.> 1 %>
        <div class="mt-4">
          <%= render PaginationComponent.new(pagy: pagy, turbo_stream_links: true) %>
        </div>
      <% end %>
    <% else %>
      <%= render Ui::EmptyStateComponent.new(icon: "fa-clock-rotate-left", title: t("views.shopping_lists.history_empty_state.title"), hint: t("views.shopping_lists.history_empty_state.hint"), size: :md) %>
    <% end %>
  <% end %>
<% end %>
