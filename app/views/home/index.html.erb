<%# ============================================================ %>
<%# NAVBAR %>
<%# ============================================================ %>
<header class="fixed top-0 inset-x-0 z-50 bg-surface-base/80 backdrop-blur-md border-b border-surface-border/40">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="<%= root_path %>" class="flex items-center gap-2.5">
      <%= image_tag "logo.png", class: "h-10 w-10", alt: "NutriFlow" %>
      <span class="text-xl font-bold text-ink-primary">NutriFlow</span>
    </a>

    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-medium text-ink-muted">
      <a href="#nutrition"    class="hover:text-ink-primary transition-colors"><%= t("views.home.nav.nutrition") %></a>
      <a href="#training"     class="hover:text-ink-primary transition-colors"><%= t("views.home.nav.training") %></a>
      <a href="#suivi"        class="hover:text-ink-primary transition-colors"><%= t("views.home.nav.suivi") %></a>
      <a href="#how-it-works" class="hover:text-ink-primary transition-colors"><%= t("views.home.nav.how_it_works") %></a>
      <a href="#faq"          class="hover:text-ink-primary transition-colors"><%= t("views.home.nav.faq") %></a>
    </nav>

    <div class="flex items-center gap-2">
      <%= link_to t("views.home.nav.login"), new_user_session_path,
            class: "text-sm font-medium text-ink-muted hover:text-ink-primary transition-colors px-4 py-2 rounded-lg" %>
      <%= link_to t("views.home.nav.signup"), new_user_registration_path,
            class: "btn-primary text-sm" %>
    </div>
  </div>
</header>


<%# ============================================================ %>
<%# HERO (centré) %>
<%# ============================================================ %>
<section class="relative bg-surface-base overflow-hidden pt-16">

  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-brand/8 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-[400px] h-[400px] bg-brand/5 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-32 w-[500px] h-[500px] bg-brand/5 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 lg:px-8 py-24 lg:py-32 text-center">
    <div class="inline-flex items-center gap-2 bg-brand/10 border border-brand/25 text-brand text-xs font-semibold px-3.5 py-1.5 rounded-full mb-7">
      <i class="fas fa-bolt text-[10px]"></i>
      <%= t("views.home.hero.badge") %>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-ink-primary leading-[1.08] tracking-tight text-balance mb-6">
      <%= t("views.home.hero.title_line1") %>
      <span class="bg-gradient-to-r from-brand to-brand-hover bg-clip-text text-transparent"><%= t("views.home.hero.title_line2") %></span>
    </h1>

    <p class="text-lg text-ink-muted leading-relaxed mb-9 max-w-2xl mx-auto">
      <%= t("views.home.hero.subtitle") %>
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
      <%= link_to new_user_registration_path, class: "btn-primary px-6 py-3.5 text-base" do %>
        <%= t("views.home.hero.cta_start") %>
        <i class="fas fa-arrow-right text-sm"></i>
      <% end %>
      <%= link_to t("views.home.hero.cta_login"), new_user_session_path,
            class: "btn-secondary px-6 py-3.5 text-base" %>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-ink-muted">
      <span class="flex items-center gap-1.5">
        <i class="fas fa-check-circle text-brand text-xs"></i>
        <%= t("views.home.hero.trust_free") %>
      </span>
      <span class="flex items-center gap-1.5">
        <i class="fas fa-check-circle text-brand text-xs"></i>
        <%= t("views.home.hero.trust_no_card") %>
      </span>
    </div>
  </div>
</section>


<%# ============================================================ %>
<%# STATS STRIP %>
<%# ============================================================ %>
<section class="bg-surface-raised border-y border-surface-border/40 py-8">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <p class="text-3xl font-bold text-brand mb-1">1 100<span class="text-xl">+</span></p>
        <p class="text-sm text-ink-muted"><%= t("views.home.stats.exercises") %></p>
      </div>
      <div>
        <p class="text-3xl font-bold text-ink-primary mb-1">20<span class="text-xl">+</span></p>
        <p class="text-sm text-ink-muted"><%= t("views.home.stats.nutrients") %></p>
      </div>
      <div>
        <p class="text-3xl font-bold text-ink-primary mb-1">∞</p>
        <p class="text-sm text-ink-muted"><%= t("views.home.stats.custom") %></p>
      </div>
      <div>
        <p class="text-3xl font-bold text-brand mb-1">100%</p>
        <p class="text-sm text-ink-muted"><%= t("views.home.stats.free") %></p>
      </div>
    </div>
  </div>
</section>


<%# ============================================================ %>
<%# NUTRITION (carrousel : calendrier · recettes · aliments) %>
<%# ============================================================ %>
<section id="nutrition" class="py-24 bg-surface-base scroll-mt-16">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-semibold text-brand uppercase tracking-widest mb-3"><%= t("views.home.features.nutrition_eyebrow") %></p>
      <h2 class="text-3xl lg:text-4xl font-bold text-ink-primary tracking-tight mb-4"><%= t("views.home.features.nutrition_title") %></h2>
      <p class="text-lg text-ink-muted leading-relaxed"><%= t("views.home.features.nutrition_desc") %></p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6">
        <% %w[nutrition_point1 nutrition_point2 nutrition_point3 nutrition_point4].each do |pt| %>
          <li class="inline-flex items-center gap-2 text-sm text-ink-primary">
            <i class="fas fa-check text-brand text-xs"></i><%= t("views.home.features.#{pt}") %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= render layout: "home/carousel", locals: { url: "nutriflow.app/calendars", count: 4 } do %>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/calendar.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_calendar") %>
      </div>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/recipe_index.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_recipe_index") %>
      </div>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/recipe_show.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_recipe_show") %>
      </div>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/food_index.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_food_index") %>
      </div>
    <% end %>
  </div>
</section>


<%# ============================================================ %>
<%# ENTRAÎNEMENT (carrousel : GIFs live · exercice · programmes) %>
<%# ============================================================ %>
<section id="training" class="py-24 bg-surface-raised scroll-mt-16">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-semibold text-brand uppercase tracking-widest mb-3"><%= t("views.home.features.training_eyebrow") %></p>
      <h2 class="text-3xl lg:text-4xl font-bold text-ink-primary tracking-tight mb-4"><%= t("views.home.features.training_title") %></h2>
      <p class="text-lg text-ink-muted leading-relaxed"><%= t("views.home.features.training_desc") %></p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6">
        <% %w[training_point1 training_point2 training_point3 training_point4].each do |pt| %>
          <li class="inline-flex items-center gap-2 text-sm text-ink-primary">
            <i class="fas fa-check text-brand text-xs"></i><%= t("views.home.features.#{pt}") %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= render layout: "home/carousel", locals: { url: "nutriflow.app/exercises", count: 3 } do %>
      <%# Slide 1 : vraie grille de GIFs animés %>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <div class="h-full grid grid-cols-4 grid-rows-2 gap-2 p-3 bg-surface-base">
          <% @exercises.each do |exercise| %>
            <div class="relative rounded-lg overflow-hidden border border-surface-border/40">
              <img src="<%= exercise.gif_url %>" loading="lazy" draggable="false" alt="<%= exercise_name(exercise) %>"
                   class="w-full h-full object-cover">
              <% if exercise.difficulty.present? %>
                <span class="absolute top-1 left-1 text-[8px] px-1.5 py-0.5 rounded-md font-medium <%= difficulty_badge_classes(exercise.difficulty) %>">
                  <%= t("views.exercises.difficulty.#{exercise.difficulty.to_s.downcase}", default: "") %>
                </span>
              <% end %>
              <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-surface-base/90 to-transparent px-2 pt-4 pb-1">
                <p class="text-[9px] font-semibold text-ink-primary truncate"><%= exercise_name(exercise) %></p>
              </div>
            </div>
          <% end %>
        </div>
      </div>
      <%# Slide 2 : fiche exercice %>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/exercise_show.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_exercise_show") %>
      </div>
      <%# Slide 3 : programmes %>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/program_index.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_program_index") %>
      </div>
    <% end %>
  </div>
</section>


<%# ============================================================ %>
<%# SUIVI & PROGRESSION (carrousel : stats nutrition · training · cardio) %>
<%# ============================================================ %>
<section id="suivi" class="py-24 bg-surface-base scroll-mt-16">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <p class="text-xs font-semibold text-brand uppercase tracking-widest mb-3"><%= t("views.home.features.stats_eyebrow") %></p>
      <h2 class="text-3xl lg:text-4xl font-bold text-ink-primary tracking-tight mb-4"><%= t("views.home.features.stats_title") %></h2>
      <p class="text-lg text-ink-muted leading-relaxed"><%= t("views.home.features.stats_desc") %></p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 mt-6">
        <% %w[stats_point1 stats_point2 stats_point3 stats_point4].each do |pt| %>
          <li class="inline-flex items-center gap-2 text-sm text-ink-primary">
            <i class="fas fa-check text-brand text-xs"></i><%= t("views.home.features.#{pt}") %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= render layout: "home/carousel", locals: { url: "nutriflow.app/statistics", count: 3 } do %>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/statistic_nutrition.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_statistic_nutrition") %>
      </div>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/statistic_training.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_statistic_training") %>
      </div>
      <div class="w-full flex-none aspect-[2/1]" data-carousel-target="slide">
        <%= image_tag "landing/statistic_cardio.png", loading: "lazy", draggable: false,
              class: "w-full h-full object-cover object-top", alt: t("views.home.features.alt_statistic_cardio") %>
      </div>
    <% end %>
  </div>
</section>


<%# ============================================================ %>
<%# HOW IT WORKS %>
<%# ============================================================ %>
<section id="how-it-works" class="py-24 bg-surface-raised scroll-mt-16">
  <div class="max-w-5xl mx-auto px-6 lg:px-8">

    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-brand uppercase tracking-widest mb-3"><%= t("views.home.how_it_works.section_label") %></p>
      <h2 class="text-4xl font-bold text-ink-primary tracking-tight"><%= t("views.home.how_it_works.section_title") %></h2>
      <p class="mt-4 text-lg text-ink-muted max-w-xl mx-auto"><%= t("views.home.how_it_works.section_subtitle") %></p>
    </div>

    <div class="relative grid md:grid-cols-4 gap-8">
      <div class="hidden md:block absolute top-9 left-[calc(12.5%+2rem)] right-[calc(12.5%+2rem)] h-px bg-gradient-to-r from-surface-border via-brand/40 to-surface-border"></div>

      <% [
        { num: "1", title: t("views.home.how_it_works.step1_title"), desc: t("views.home.how_it_works.step1_desc") },
        { num: "2", title: t("views.home.how_it_works.step2_title"), desc: t("views.home.how_it_works.step2_desc") },
        { num: "3", title: t("views.home.how_it_works.step3_title"), desc: t("views.home.how_it_works.step3_desc") },
        { num: "4", title: t("views.home.how_it_works.step4_title"), desc: t("views.home.how_it_works.step4_desc") },
      ].each do |step| %>
        <div class="relative flex flex-col items-center text-center">
          <div class="w-[4.5rem] h-[4.5rem] rounded-2xl bg-brand text-surface-base flex items-center justify-center text-2xl font-bold mb-6 shadow-lg shadow-brand/20 relative z-10">
            <%= step[:num] %>
          </div>
          <h3 class="text-base font-semibold text-ink-primary mb-2"><%= step[:title] %></h3>
          <p class="text-sm text-ink-muted leading-relaxed"><%= step[:desc] %></p>
        </div>
      <% end %>
    </div>

  </div>
</section>


<%# ============================================================ %>
<%# FAQ %>
<%# ============================================================ %>
<section id="faq" class="py-24 bg-surface-base scroll-mt-16">
  <div class="max-w-3xl mx-auto px-6 lg:px-8">

    <div class="text-center mb-14">
      <p class="text-sm font-semibold text-brand uppercase tracking-widest mb-3"><%= t("views.home.faq.section_label") %></p>
      <h2 class="text-4xl font-bold text-ink-primary tracking-tight"><%= t("views.home.faq.section_title") %></h2>
      <p class="mt-4 text-lg text-ink-muted"><%= t("views.home.faq.section_subtitle") %></p>
    </div>

    <div class="space-y-3">
      <% (1..8).each do |i| %>
        <details class="group bg-surface-raised border border-surface-border/40 rounded-xl overflow-hidden">
          <summary class="flex items-center justify-between gap-4 cursor-pointer px-6 py-5 list-none [&::-webkit-details-marker]:hidden">
            <span class="font-semibold text-ink-primary"><%= t("views.home.faq.q#{i}_q") %></span>
            <i class="fas fa-chevron-down text-ink-subtle text-sm transition-transform duration-200 group-open:rotate-180"></i>
          </summary>
          <div class="px-6 pb-5 text-ink-muted leading-relaxed"><%= t("views.home.faq.q#{i}_a") %></div>
        </details>
      <% end %>
    </div>

  </div>
</section>


<%# ============================================================ %>
<%# CTA FINAL %>
<%# ============================================================ %>
<section class="relative py-28 bg-surface-base overflow-hidden">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-brand/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-brand/8 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-2xl mx-auto px-6 text-center">
    <p class="text-sm font-semibold text-brand uppercase tracking-widest mb-4"><%= t("views.home.cta.label") %></p>
    <h2 class="text-4xl lg:text-5xl font-bold text-ink-primary tracking-tight mb-5">
      <%= t("views.home.cta.title") %>
    </h2>
    <p class="text-lg text-ink-muted mb-10 leading-relaxed">
      <%= t("views.home.cta.subtitle") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <%= link_to new_user_registration_path, class: "btn-primary px-8 py-4 text-base" do %>
        <%= t("views.home.cta.button") %>
        <i class="fas fa-arrow-right"></i>
      <% end %>
      <%= link_to t("views.home.cta.login"), new_user_session_path,
            class: "btn-secondary px-8 py-4 text-base" %>
    </div>
    <p class="mt-6 text-sm text-ink-subtle"><%= t("views.home.cta.fine") %></p>
  </div>
</section>


<%# ============================================================ %>
<%# FOOTER %>
<%# ============================================================ %>
<footer class="bg-surface-base pt-14 pb-10 border-t border-surface-border/50">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10">
      <div class="flex items-center gap-2.5">
        <%= image_tag "logo.png", class: "h-10 w-10", alt: "NutriFlow" %>
        <div>
          <span class="text-ink-primary font-semibold text-sm block">NutriFlow</span>
          <span class="text-ink-subtle text-xs"><%= t("views.home.footer.tagline") %></span>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-10">
        <div>
          <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-4"><%= t("views.home.footer.col_product") %></p>
          <ul class="space-y-2.5 text-sm text-ink-muted">
            <li><a href="#nutrition" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.nutrition") %></a></li>
            <li><a href="#training" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.training") %></a></li>
            <li><a href="#suivi" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.suivi") %></a></li>
            <li><a href="#how-it-works" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.how_it_works") %></a></li>
            <li><a href="#faq" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.faq") %></a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-4"><%= t("views.home.footer.col_account") %></p>
          <ul class="space-y-2.5 text-sm text-ink-muted">
            <li><%= link_to t("views.home.footer.login"), new_user_session_path, class: "hover:text-ink-primary transition-colors" %></li>
            <li><%= link_to t("views.home.footer.signup"), new_user_registration_path, class: "hover:text-ink-primary transition-colors" %></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-semibold text-ink-subtle uppercase tracking-widest mb-4"><%= t("views.home.footer.col_legal") %></p>
          <ul class="space-y-2.5 text-sm text-ink-muted">
            <li><a href="#" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.legal_notice") %></a></li>
            <li><a href="#" class="hover:text-ink-primary transition-colors"><%= t("views.home.footer.privacy") %></a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-surface-border/30 text-sm text-ink-subtle">
      © <%= Date.current.year %> NutriFlow. <%= t("views.home.footer.rights") %>
    </div>
  </div>
</footer>
