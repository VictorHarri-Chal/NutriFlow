<% period_label = t("views.statistics.period_labels.#{@period}") %>

<% if @logged_days.empty? %>
  <%= render Ui::EmptyStateComponent.new(
        icon:  "fa-utensils",
        title: t("views.statistics.nutrition.no_data_title", period: period_label),
        hint:  t("views.statistics.nutrition.no_data_hint"),
        size:  :lg) do |c| %>
    <% c.with_cta do %>
      <%= link_to t("views.statistics.go_to_calendar"), root_path, class: "btn-secondary text-xs px-4 py-2" %>
    <% end %>
  <% end %>

<% else %>

  <%# ── KPI cards (4 colonnes) ── %>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

    <%= render Ui::StatCardComponent.new(
          label: t("views.statistics.nutrition.kpi_avg_calories"),
          value: @avg_calories,
          unit: "kcal",
          value_color: "text-macro-calories") do |m| %>
      <% if @calorie_goal > 0 %>
        <% m.with_sub do %>
          <%
            diff  = @avg_calories - @calorie_goal
            color = diff.abs <= (@calorie_goal * 0.05) ? "text-status-success" : diff > 0 ? "text-status-warning" : "text-ink-subtle"
          %>
          <p class="text-xs mt-1.5 <%= color %>">
            <%= diff >= 0 ? "+#{diff}" : diff %> vs objectif (<%= @calorie_goal %>)
          </p>
        <% end %>
      <% end %>
    <% end %>

    <%= render Ui::StatCardComponent.new(
          label: t("views.statistics.nutrition.kpi_days_logged"),
          value: @days_logged_count,
          unit: "/ #{@total_period_days} j") do |m| %>
      <% m.with_sub do %>
        <div class="mt-3">
          <%= render Ui::ProgressBarComponent.new(
                percent: (@days_logged_count.to_f / @total_period_days * 100).round,
                color: "bg-brand", height: "h-1.5") %>
        </div>
      <% end %>
    <% end %>

    <%= render Ui::StatCardComponent.new(
          label: t("views.statistics.nutrition.kpi_avg_proteins"),
          value: @avg_proteins,
          unit: "g",
          value_color: "text-macro-proteins") do |m| %>
      <% m.with_sub do %>
        <div class="flex items-center gap-3 mt-1.5">
          <span class="text-xs text-ink-subtle">G <span class="text-macro-carbs font-medium"><%= @avg_carbs %>g</span></span>
          <span class="text-xs text-ink-subtle">L <span class="text-macro-fats font-medium"><%= @avg_fats %>g</span></span>
        </div>
      <% end %>
    <% end %>

    <%= render Ui::StatCardComponent.new(
          label: t("views.statistics.nutrition.kpi_streak"),
          value: @current_streak,
          unit: t("views.statistics.nutrition.streak_days", count: @current_streak),
          value_color: "text-brand") do |m| %>
      <% m.with_sub do %>
        <p class="text-xs text-ink-subtle mt-1.5"><%= t("views.statistics.nutrition.streak_best", n: @best_streak) %></p>
      <% end %>
    <% end %>

  </div>

  <%# ── Calories + macros donut ── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%= render Ui::PanelComponent.new(class: "lg:col-span-2") do %>
      <h2 class="text-sm font-semibold text-ink-primary mb-4 flex items-center gap-2">
        <i class="fas fa-chart-line text-brand text-xs"></i>
        <%= t("views.statistics.nutrition.calories_title") %>
      </h2>
      <div class="relative h-48">
        <canvas data-controller="line-chart"
                data-line-chart-labels-value="<%= @cal_labels.to_json %>"
                data-line-chart-data-value="<%= @cal_data.to_json %>"
                data-line-chart-unit-value="kcal"
                data-line-chart-color-value="#60A5FA"
                data-line-chart-goal-value="<%= @calorie_goal %>">
        </canvas>
      </div>
    <% end %>

    <%= render Ui::PanelComponent.new do %>
      <h2 class="text-sm font-semibold text-ink-primary mb-4 flex items-center gap-2">
        <i class="fas fa-chart-pie text-brand text-xs"></i>
        <%= t("views.statistics.nutrition.macros_title") %>
      </h2>
      <div class="relative h-48">
        <canvas data-controller="donut-chart"
                data-donut-chart-labels-value="<%= @macros_donut_labels.to_json %>"
                data-donut-chart-data-value="<%= @macros_donut_data.to_json %>"
                data-donut-chart-colors-value="<%= ['#34D399', '#FBBF24', '#F87171'].to_json %>">
        </canvas>
      </div>
    <% end %>

  </div>

  <%# ── Protéines + répartition repas ── %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">

    <%= render Ui::PanelComponent.new(class: "lg:col-span-2") do %>
      <h2 class="text-sm font-semibold text-ink-primary mb-4 flex items-center gap-2">
        <i class="fas fa-chart-area text-brand text-xs"></i>
        <%= t("views.statistics.nutrition.protein_title") %>
      </h2>
      <div class="relative h-48">
        <canvas data-controller="line-chart"
                data-line-chart-labels-value="<%= @protein_labels.to_json %>"
                data-line-chart-data-value="<%= @protein_data.to_json %>"
                data-line-chart-unit-value="<%= t("views.statistics.nutrition.protein_unit") %>"
                data-line-chart-color-value="#34D399">
        </canvas>
      </div>
    <% end %>

    <%= render Ui::PanelComponent.new do %>
      <h2 class="text-sm font-semibold text-ink-primary mb-4 flex items-center gap-2">
        <i class="fas fa-bowl-food text-brand text-xs"></i>
        <%= t("views.statistics.nutrition.meal_title") %>
      </h2>
      <% if @meal_breakdown_data&.any? %>
        <div class="relative h-48">
          <canvas data-controller="donut-chart"
                  data-donut-chart-labels-value="<%= @meal_breakdown_labels.to_json %>"
                  data-donut-chart-data-value="<%= @meal_breakdown_data.to_json %>">
          </canvas>
        </div>
      <% else %>
        <%= render Ui::ChartPlaceholderComponent.new(
              icon: "fa-layer-group",
              text: t("views.statistics.nutrition.meal_breakdown_empty"),
              height: "h-48") %>
      <% end %>
    <% end %>

  </div>

  <%# ── Tendances micronutriments ── %>
  <%= render Ui::PanelComponent.new do %>
    <%= render Ui::SectionHeaderComponent.new(icon: "fa-flask",
          title: t("views.statistics.nutrition.micronutrient_trend_title"), size: :sm, class: "mb-4 flex-wrap") do |c| %>
      <% c.with_actions do %>
        <%= form_with url: statistics_path, method: :get, data: { turbo_frame: "micronutrient_chart" } do |f| %>
          <%= hidden_field_tag :period, @period %>
          <%= hidden_field_tag :tab, @tab %>
          <div data-controller="custom-select" class="relative w-56">
            <%= select_tag :micronutrient,
                  options_for_select(@micronutrient_options.map { |e| [e.label, e.key] }, @selected_micronutrient.key),
                  class: "sr-only", data: { custom_select_target: "select" },
                  onchange: "this.form.requestSubmit()" %>
            <button type="button" data-action="click->custom-select#toggle"
                    class="input-dark flex items-center justify-between cursor-pointer w-full text-left text-sm">
              <span data-custom-select-target="label" class="text-ink-subtle"></span>
              <i class="fas fa-chevron-down text-xs text-ink-subtle flex-shrink-0"></i>
            </button>
            <div data-custom-select-target="dropdown"
                 class="hidden absolute z-50 w-full mt-1 bg-surface-raised border border-surface-border/60 rounded-lg shadow-2xl max-h-52 overflow-y-auto"></div>
          </div>
        <% end %>
      <% end %>
    <% end %>
    <%= turbo_frame_tag "micronutrient_chart" do %>
      <div class="relative h-48">
        <canvas data-controller="line-chart"
                data-line-chart-labels-value="<%= @micronutrient_labels.to_json %>"
                data-line-chart-data-value="<%= @micronutrient_data.to_json %>"
                data-line-chart-unit-value="<%= @selected_micronutrient.unit %>"
                data-line-chart-color-value="#A78BFA"
                data-line-chart-goal-value="<%= @micronutrient_daily_goal %>">
        </canvas>
      </div>
    <% end %>
  <% end %>

<% end %>
