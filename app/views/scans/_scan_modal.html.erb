<%= render Ui::ModalComponent.new(
      title: t("views.scans.modal_title"),
      max_width: :xl,
      max_height: :md,
      body_padding: "",
      data: {
        controller: "scan-result",
        action: "barcode-scanner:product@document->scan-result#handleProduct",
        scan_result_create_url_value: scans_path,
        scan_result_allergens_map_value: json_escape(I18n.t('views.foods.show.allergens_map').transform_keys(&:to_s).to_json),
        scan_result_labels_map_value: json_escape(I18n.t('views.foods.show.labels_map').transform_keys(&:to_s).to_json),
        scan_result_nutrient_labels_value: json_escape(I18n.t('views.foods.show.nutrients').transform_keys(&:to_s).to_json),
        scan_result_ns_descs_value: json_escape(I18n.t('views.foods.show.nutriscore_description').transform_keys(&:to_s).to_json),
        scan_result_nova_descs_value: json_escape(I18n.t('views.foods.show.nova_description').transform_keys(&:to_s).to_json),
        scan_result_eco_descs_value: json_escape(I18n.t('views.foods.show.ecoscore_description').transform_keys(&:to_s).to_json)
      }
    ) do |m| %>
  <% m.with_body do %>
    <div data-scan-result-target="scanStep" class="p-5">
      <%= render "foods/barcode_scan_panel", lookup_url: lookup_scans_path, auto_open_camera: true, show_cancel_link: false %>
    </div>

    <div data-scan-result-target="productStep" class="hidden">
      <%= render "scans/product_card" %>
    </div>
  <% end %>
<% end %>
