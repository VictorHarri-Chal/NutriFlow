<div class="flex flex-col items-center justify-center gap-2 border border-dashed border-surface-border/50 rounded-card text-center px-4 <%= height %>">
  <i class="fas <%= icon %> text-2xl text-ink-subtle/50"></i>
  <p class="text-sm text-ink-muted"><%= text %></p>
  <% if subtext.present? %>
    <p class="text-xs text-ink-subtle"><%= subtext %></p>
  <% end %>
</div>
