<%= tag.div class: "fixed inset-0 z-50 flex items-center justify-center p-4", data: root_data do %>
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>

  <div class="relative w-full <%= max_width %> bg-surface-raised border border-surface-border/50 rounded-panel shadow-modal transition-all duration-200 ease-out scale-95 opacity-0 flex flex-col <%= max_height %> overflow-hidden"
       data-modal-target="panel">
    <div class="flex items-center justify-between px-5 py-4 border-b border-surface-border/40 flex-shrink-0">
      <div class="min-w-0 flex items-center gap-2">
        <% if icon %>
          <i class="fas <%= icon %> text-ink-muted text-sm"></i>
        <% end %>
        <div class="min-w-0">
          <h3 class="text-sm font-semibold text-ink-primary break-words"><%= title %></h3>
          <% if subtitle %>
            <p class="text-xs text-ink-subtle mt-0.5"><%= subtitle %></p>
          <% end %>
        </div>
        <% if title_accessory? %><%= title_accessory %><% end %>
      </div>
      <button type="button"
              class="btn-ghost w-8 h-8 !p-0 flex items-center justify-center flex-shrink-0"
              data-action="click->modal#close">
        <%= helpers.ui_icon(:close, css: "text-sm") %>
      </button>
    </div>

    <div class="<%= [body_padding, body_layout].reject(&:blank?).join(" ") %>"><%= body %></div>

    <% if footer? %>
      <div data-modal-footer class="border-t border-surface-border/40 px-5 py-4 flex-shrink-0"><%= footer %></div>
    <% end %>
  </div>
<% end %>
