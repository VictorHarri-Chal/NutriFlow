<div data-controller="collapsible"
     data-collapsible-storage-key="<%= storage_key %>"
     <%= "data-collapsible-force-open" if force_open %>
     class="bg-surface-raised border border-surface-border/40 rounded-panel px-5 py-3 mb-4">
  <div class="flex items-center justify-between cursor-pointer select-none"
       data-collapsible-target="trigger"
       data-action="click->collapsible#toggle">
    <span class="text-xs font-medium text-ink-subtle uppercase tracking-wider"><%= title %></span>
    <div class="flex items-center gap-2">
      <% if header_action? %>
        <div data-action="click->collapsible#stopEvent"><%= header_action %></div>
      <% end %>
      <span data-collapsible-target="icon" class="transition-transform duration-200">
        <%= helpers.ui_icon(:chevron_down, css: "text-xs text-ink-subtle") %>
      </span>
    </div>
  </div>
  <div data-collapsible-target="content" class="mt-3"><%= content_body %></div>
</div>
